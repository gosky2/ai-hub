# AI Hub server settings. `aihub init` copies this to .env and fills the three secrets for you.
# Never commit .env. Keep comments on their own lines (env parsers differ on inline #).

# --- secrets (aihub init generates random values) ---
# Password for the web page
VIEW_PASSWORD=
# Admin token for hooks on this machine (other machines get their own token via join.sh)
EVENT_TOKEN=
# Signs login cookies and share links
COOKIE_SECRET=

# --- network ---
PORT=4200
# 0.0.0.0 accepts other machines on your network (put HTTPS in front before exposing it to the internet)
HOST=127.0.0.1
# Address other machines and share links use, e.g. https://hub.example.com
PUBLIC_URL=http://localhost:4200
# Optional short domain whose /s/ path is proxied here
# SHORT_URL=
# Set to /ai-hub/ when a reverse proxy serves the hub under a sub-path
# COOKIE_PATH=/
# 1 or 0 to force the Secure cookie flag (default: on for https and localhost)
# COOKIE_SECURE=

# --- storage ---
DB_PATH=data/hub.db
# FILES_DIR=data/files
# Characters of each instruction, message and answer kept in the event log (lower = less kept, 0 = none; the chat shows answers up to this length)
TEXT_LIMIT=4000
# "Today" in token usage follows this time zone
# TZ=UTC
